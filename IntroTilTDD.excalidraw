    {
      "id": "C9udtrO5vazM-rIc85H9_",
      "type": "text",
      "x": 375.6875615038391,
      "y": 608.2744330545446,
      "width": 658.1395874023438,
      "height": 175,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
