      "isDeleted": false,
      "boundElements": null,
      "updated": 1774264716742,
      "link": null,
      "locked": false,
      "text": "Når vi starter et prosjekt vet vi ikke:\n    - Alle krav\n    - Alle edge cases\n    - Alle avegigheter ",
